generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Nullable on User itself to allow bootstrapping the first/system user
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  name         String
  email        String @unique
  passwordHash String @map("password_hash")
  // Null while the User is Unverified (see CONTEXT.md, "Verified user").
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Stamped into each session's JWT at login. Bumping it logs out every
  // session logged in before (a completed Password reset does this).
  sessionVersion  Int       @default(0) @map("session_version")

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  // Audit back-relations
  createdUsers         User[]          @relation("UserCreatedBy")
  updatedUsers         User[]          @relation("UserUpdatedBy")
  createdGroups        Group[]         @relation("GroupCreatedBy")
  updatedGroups        Group[]         @relation("GroupUpdatedBy")
  createdPieces        Piece[]         @relation("PieceCreatedBy")
  updatedPieces        Piece[]         @relation("PieceUpdatedBy")
  createdFiles         File[]          @relation("FileCreatedBy")
  updatedFiles         File[]          @relation("FileUpdatedBy")
  createdPeople        Person[]        @relation("PersonCreatedBy")
  updatedPeople        Person[]        @relation("PersonUpdatedBy")
  createdLinks         Link[]          @relation("LinkCreatedBy")
  updatedLinks         Link[]          @relation("LinkUpdatedBy")
  createdSetLists      SetList[]       @relation("SetListCreatedBy")
  updatedSetLists      SetList[]       @relation("SetListUpdatedBy")
  createdSetListPieces SetListPiece[]  @relation("SetListPieceCreatedBy")
  updatedSetListPieces SetListPiece[]  @relation("SetListPieceUpdatedBy")
  createdSetListPieceNotes SetListPieceNote[] @relation("SetListPieceNoteCreatedBy")
  updatedSetListPieceNotes SetListPieceNote[] @relation("SetListPieceNoteUpdatedBy")
  createdSetListNotes    SetListNote[]   @relation("SetListNoteCreatedBy")
  updatedSetListNotes    SetListNote[]   @relation("SetListNoteUpdatedBy")
  createdPieceNotes    PieceNote[]     @relation("PieceNoteCreatedBy")
  updatedPieceNotes    PieceNote[]     @relation("PieceNoteUpdatedBy")
  groups               UsersToGroups[]
  tokens               UserToken[]
  sentInvitations      Invitation[]
  createdAnnouncements Announcement[]  @relation("AnnouncementCreatedBy")
  updatedAnnouncements Announcement[]  @relation("AnnouncementUpdatedBy")
  announcementReads    AnnouncementRead[]

  @@map("users")
}

// What a UserToken proves when redeemed.
enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("user_token_purpose")
}

// Single-use emailed tokens. Only a hash of the token is stored. Used and
// superseded tokens are kept (marked, not deleted) so a reused link can be
// told apart from an unknown one.
model UserToken {
  id            String           @id @default(uuid())
  createdAt     DateTime         @default(now()) @map("created_at")
  userId        String           @map("user_id")
  purpose       UserTokenPurpose
  tokenHash     String           @unique @map("token_hash")
  expiresAt     DateTime         @map("expires_at")
  usedAt        DateTime?        @map("used_at")
  invalidatedAt DateTime?        @map("invalidated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

model Group {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Required: it is what makes someone Creator (ADR-0002), so Account
  // deletion deletes or is blocked by the Group rather than clearing it.
  createdById String   @map("created_by_id")
  // Like every other audit column, cleared when that User is deleted (ADR-0006).
  updatedById String?  @map("updated_by_id")

  name String
  slug String @unique @map("slug")
  // The Group description: Markdown for its Members, shown on Home. Blank is
  // stored as null, meaning the Group has none.
  description          String?
  // When the description last changed, for the Group overview's "last
  // changed"; renaming the Group doesn't count, so `updatedAt` can't serve.
  descriptionUpdatedAt DateTime? @map("description_updated_at")

  createdBy User @relation("GroupCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("GroupUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  users      UsersToGroups[]
  pieces     Piece[]
  people     Person[]
  setLists   SetList[]
  pieceNotes PieceNote[]
  setListPieceNotes SetListPieceNote[]
  invitations       Invitation[]

  @@map("groups")
}

model UsersToGroups {
  userId  String @map("user_id")
  groupId String @map("group_id")

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group  Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  claims GroupMemberClaim[]

  @@id([userId, groupId])
  @@map("users_to_groups")
}

// An offer for one email address to become a Member of one Group (see
// CONTEXT.md, "Invitation", and docs/adr/0003). At most one per (Group,
// email): inviting the same address again re-sends this one with a new token.
model Invitation {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  groupId     String   @map("group_id")
  // Normalized: trimmed and lower-cased.
  email       String
  // Who sent it most recently, and when. Cleared if that User is deleted; the
  // Invitation stays valid even if they leave or lose MANAGE_MEMBERS.
  invitedById String?  @map("invited_by_id")
  invitedAt   DateTime @default(now()) @map("invited_at")

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User?             @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  tokens    InvitationToken[]

  @@unique([groupId, email])
  @@map("invitations")
}

// An emailed accept link for an Invitation. Same rules as UserToken: only a
// hash is stored, single use, and used or superseded tokens are kept (marked,
// not deleted) so a reused link can be told apart from an unknown one.
model InvitationToken {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now()) @map("created_at")
  invitationId  String    @map("invitation_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_tokens")
}

// Elevated capabilities a Member can hold within one Group. The Creator is
// never stored here — Creator status is Group.createdById and implies every
// Claim (see docs/adr/0002-group-membership-gains-claims.md).
enum GroupClaim {
  MANAGE_MEMBERS
  MANAGE_CONTENT
  REORDER_SET_LISTS
  MANAGE_RUNNING_ORDER_NOTES
  MANAGE_MEMBER_AUTHORIZATION
  MANAGE_GROUP_HOME

  @@map("group_claim")
}

model GroupMemberClaim {
  userId  String     @map("user_id")
  groupId String     @map("group_id")
  claim   GroupClaim

  // Hangs off the membership row, so removing a Member drops their Claims.
  membership UsersToGroups @relation(fields: [userId, groupId], references: [userId, groupId], onDelete: Cascade)

  @@id([userId, groupId, claim])
  @@map("group_member_claims")
}

model Piece {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  name    String
  /// Made from the name and unique in the Group among its kind (CONTEXT.md, "Slug"; ADR-0011).
  slug    String
  groupId String @map("group_id")

  createdBy      User?           @relation("PieceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("PieceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  files          File[]
  credits        PersonToPiece[]
  links          Link[]
  setListEntries SetListPiece[]
  notes          PieceNote[]
  aliases        PieceAlias[]

  @@unique([groupId, slug])
  @@map("pieces")
}

/// Another name a Piece goes by (CONTEXT.md: Alias), listed in the order added.
model PieceAlias {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  name    String
  pieceId String @map("piece_id")

  piece Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([pieceId, createdAt])
  @@map("piece_aliases")
}

model Link {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  url      String
  label    String?
  /// See Category in CONTEXT.md; `null` is uncategorized.
  category String?

  pieceId String @map("piece_id")

  createdBy User? @relation("LinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("LinkUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  piece     Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  hiddenOnSetListPieces SetListPieceHiddenLink[]

  @@map("links")
}

/// How preparing a MuseScore File for the player went (ADR-0009).
enum FileConversionState {
  PENDING
  READY
  FAILED
}

model File {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  displayName String @map("display_name")
  /// Made from the display name and unique among the Group's Files, which the database can't check through the Piece (ADR-0011).
  slug        String
  fileName    String @map("file_name")
  storagePath String @unique @map("storage_path")
  mimeType    String @map("mime_type")
  size        Int
  /// See Category in CONTEXT.md; `null` is uncategorized.
  category    String?
  /// How preparing a MuseScore File for the player went (ADR-0009); `null` for a File played as uploaded, or not at all.
  conversionState      FileConversionState? @map("conversion_state")
  /// Where the MusicXML derived from a MuseScore File is stored, once its conversion is ready.
  convertedStoragePath String?              @unique @map("converted_storage_path")

  pieceId   String @map("piece_id")
  createdBy User?  @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("FileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  piece     Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  hiddenOnSetListPieces SetListPieceHiddenFile[]

  @@index([pieceId, slug])
  @@map("files")
}

model Person {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  name    String
  /// Made from the name and unique in the Group among its kind (CONTEXT.md, "Slug"; ADR-0011).
  slug    String
  groupId String @map("group_id")

  createdBy User?           @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("PersonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  credits   PersonToPiece[]

  @@unique([groupId, slug])
  @@map("people")
}

model PersonToPiece {
  personId String @map("person_id")
  pieceId  String @map("piece_id")
  role     String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  piece  Piece  @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@id([personId, pieceId, role])
  @@map("people_to_pieces")
}

model SetList {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  name    String
  /// Made from the name and unique in the Group among its kind (CONTEXT.md, "Slug"; ADR-0011).
  slug    String
  date    DateTime?
  // Marked by hand as being worked on now (CONTEXT.md, "Current"); never ends on its own.
  current Boolean   @default(false)
  groupId String    @map("group_id")

  createdBy User?          @relation("SetListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("SetListUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pieces    SetListPiece[]
  notes     SetListNote[]

  @@unique([groupId, slug])
  @@map("set_lists")
}

model SetListPiece {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  setListId String @map("set_list_id")
  pieceId   String @map("piece_id")
  position  Int

  createdBy User?   @relation("SetListPieceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("SetListPieceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  setList   SetList @relation(fields: [setListId], references: [id], onDelete: Cascade)
  piece     Piece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  notes     SetListPieceNote[]

  hiddenFiles SetListPieceHiddenFile[]
  hiddenLinks SetListPieceHiddenLink[]

  @@map("set_list_pieces")
}

/// A File Hidden on one Set list piece (CONTEXT.md, "Hidden"). The File belongs to the Set list piece's Piece.
model SetListPieceHiddenFile {
  setListPieceId String @map("set_list_piece_id")
  fileId         String @map("file_id")

  setListPiece SetListPiece @relation(fields: [setListPieceId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([setListPieceId, fileId])
  @@index([fileId])
  @@map("set_list_piece_hidden_files")
}

/// A Link Hidden on one Set list piece (CONTEXT.md, "Hidden"). The Link belongs to the Set list piece's Piece.
model SetListPieceHiddenLink {
  setListPieceId String @map("set_list_piece_id")
  linkId         String @map("link_id")

  setListPiece SetListPiece @relation(fields: [setListPieceId], references: [id], onDelete: Cascade)
  link         Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([setListPieceId, linkId])
  @@index([linkId])
  @@map("set_list_piece_hidden_links")
}

model PieceNote {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  content String @db.Text
  pieceId String @map("piece_id")
  groupId String @map("group_id")

  createdBy User? @relation("PieceNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PieceNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  piece     Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, pieceId])
  @@map("piece_notes")
}

model SetListPieceNote {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  content      String @db.Text
  setListPieceId String @map("set_list_piece_id")
  groupId      String @map("group_id")

  createdBy    User?        @relation("SetListPieceNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("SetListPieceNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  setListPiece SetListPiece @relation(fields: [setListPieceId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, setListPieceId])
  @@map("set_list_piece_notes")
}

model SetListNote {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  content   String @db.Text
  setListId String @map("set_list_id")
  position  Int

  createdBy User?   @relation("SetListNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("SetListNoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  setList   SetList @relation(fields: [setListId], references: [id], onDelete: Cascade)

  @@map("set_list_notes")
}

// News about Sjung itself, published by an Operator to every Verified user
// (CONTEXT.md, "Announcement"; ADR-0008). The creator is the author: stored,
// never shown to readers, and cleared when they are deleted (ADR-0006).
model Announcement {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  title       String
  /// The publishing date in Stockholm, then the title's Slug (ADR-0011).
  slug        String   @unique
  body        String   @db.Text
  // Saving a new Announcement publishes it at once; there are no drafts.
  publishedAt DateTime @default(now()) @map("published_at")

  createdBy User?              @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation("AnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reads     AnnouncementRead[]

  @@index([publishedAt])
  @@map("announcements")
}

// That a User has read an Announcement. Announcements published before the
// User's account was created count as read without a row here.
model AnnouncementRead {
  userId         String   @map("user_id")
  announcementId String   @map("announcement_id")
  readAt         DateTime @default(now()) @map("read_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([announcementId])
  @@map("announcement_reads")
}
