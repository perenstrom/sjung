DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
# Disposable Postgres database for integration tests (see docs/testing-access-rights.md)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/dbname_test?schema=public"
AUTH_SECRET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
# Leave empty locally to print emails to the dev server console instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM=""
# Inbox that Feedback from the app is emailed to. Optional locally while
# emails are only printed; required wherever emails are really sent.
FEEDBACK_EMAIL_TO=""
# Origin for links in emails, e.g. "https://sjung.app". Required to send any
# email; links are never built from request headers.
APP_BASE_URL="http://localhost:3000"
# Which deployed environment this is: "staging" or "production". Labels the
# browser tab title on staging. Leave empty locally (`npm run dev` is always "local").
APP_ENV=""
