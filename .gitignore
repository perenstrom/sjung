# env files (can opt-in for committing if needed)
.env*
!.env.example

# player assets copied from node_modules (scripts/copy-player-assets.mjs)
/public/vendor

# prisma generated client
/app/generated/prisma

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
