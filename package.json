{
  "name": "sjung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "npm run db:migrate:deploy:test && vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:e2e": "npm run db:migrate:deploy:e2e && playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:test": "tsx scripts/migrate-db.ts TEST_DATABASE_URL",
    "db:migrate:deploy:e2e": "tsx scripts/migrate-db.ts E2E_DATABASE_URL",
    "db:migrate:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/render": "^2.3.1",
    "@sindresorhus/slugify": "^4.0.1",
    "@tanstack/react-table": "^8.21.3",
    "argon2": "^0.45.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "eslint-plugin-react": "https://codeload.github.com/jsx-eslint/eslint-plugin-react/tar.gz/012ec39f962627d5312e9fbaee3eb41d9a4d8bb6"
  }
}
